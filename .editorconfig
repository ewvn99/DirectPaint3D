[*.cs]

# IDE0350: Use implicitly typed lambda
dotnet_diagnostic.IDE0350.severity = none

[*.cs]
#### Estilos de nomenclatura ####

# Reglas de nomenclatura

dotnet_naming_rule.struct_should_be_pascal_case.severity = warning
dotnet_naming_rule.struct_should_be_pascal_case.symbols = struct
dotnet_naming_rule.struct_should_be_pascal_case.style = pascal_case

dotnet_naming_rule.enum_should_be_empieza_con_e.severity = warning
dotnet_naming_rule.enum_should_be_empieza_con_e.symbols = enum
dotnet_naming_rule.enum_should_be_empieza_con_e.style = empieza_con_e

dotnet_naming_rule.delegate_should_be_empieza_con_d.severity = warning
dotnet_naming_rule.delegate_should_be_empieza_con_d.symbols = delegate
dotnet_naming_rule.delegate_should_be_empieza_con_d.style = empieza_con_d

dotnet_naming_rule.interface_should_be_begins_with_i.severity = warning
dotnet_naming_rule.interface_should_be_begins_with_i.symbols = interface
dotnet_naming_rule.interface_should_be_begins_with_i.style = begins_with_i

dotnet_naming_rule.literal_should_be_literal.severity = warning
dotnet_naming_rule.literal_should_be_literal.symbols = literal
dotnet_naming_rule.literal_should_be_literal.style = literal

dotnet_naming_rule.private_protected_cpo_should_be_empieza_con___camell.severity = warning
dotnet_naming_rule.private_protected_cpo_should_be_empieza_con___camell.symbols = private_protected_cpo
dotnet_naming_rule.private_protected_cpo_should_be_empieza_con___camell.style = empieza_con___camell

dotnet_naming_rule.private_protected_prop_should_be_empieza_con__.severity = warning
dotnet_naming_rule.private_protected_prop_should_be_empieza_con__.symbols = private_protected_prop
dotnet_naming_rule.private_protected_prop_should_be_empieza_con__.style = empieza_con__

dotnet_naming_rule.private_prop_should_be_empieza_con_m_.severity = warning
dotnet_naming_rule.private_prop_should_be_empieza_con_m_.symbols = private_prop
dotnet_naming_rule.private_prop_should_be_empieza_con_m_.style = empieza_con_m_

dotnet_naming_rule.internal_static_prop_should_be_empieza_con_fs_.severity = warning
dotnet_naming_rule.internal_static_prop_should_be_empieza_con_fs_.symbols = internal_static_prop
dotnet_naming_rule.internal_static_prop_should_be_empieza_con_fs_.style = empieza_con_fs_

dotnet_naming_rule.internal_prop_o_evt_should_be_empieza_con_f_.severity = warning
dotnet_naming_rule.internal_prop_o_evt_should_be_empieza_con_f_.symbols = internal_prop_o_evt
dotnet_naming_rule.internal_prop_o_evt_should_be_empieza_con_f_.style = empieza_con_f_

dotnet_naming_rule.public_miembro_should_be_pascal_case.severity = warning
dotnet_naming_rule.public_miembro_should_be_pascal_case.symbols = public_miembro
dotnet_naming_rule.public_miembro_should_be_pascal_case.style = pascal_case

dotnet_naming_rule.local_static_met_should_be_empieza_con_is_.severity = warning
dotnet_naming_rule.local_static_met_should_be_empieza_con_is_.symbols = local_static_met
dotnet_naming_rule.local_static_met_should_be_empieza_con_is_.style = empieza_con_is_

dotnet_naming_rule.local_met_should_be_empieza_con_i_.severity = warning
dotnet_naming_rule.local_met_should_be_empieza_con_i_.symbols = local_met
dotnet_naming_rule.local_met_should_be_empieza_con_i_.style = empieza_con_i_

# Especificaciones de símbolos

dotnet_naming_symbols.struct.applicable_kinds = struct
dotnet_naming_symbols.struct.applicable_accessibilities = public, internal, private, protected, protected_internal, private_protected
dotnet_naming_symbols.struct.required_modifiers = 

dotnet_naming_symbols.enum.applicable_kinds = enum
dotnet_naming_symbols.enum.applicable_accessibilities = public, internal, private, protected, protected_internal, private_protected
dotnet_naming_symbols.enum.required_modifiers = 

dotnet_naming_symbols.delegate.applicable_kinds = delegate
dotnet_naming_symbols.delegate.applicable_accessibilities = public, internal, private, protected, protected_internal, private_protected
dotnet_naming_symbols.delegate.required_modifiers = 

dotnet_naming_symbols.interface.applicable_kinds = interface
dotnet_naming_symbols.interface.applicable_accessibilities = public, internal, private, protected, protected_internal, private_protected
dotnet_naming_symbols.interface.required_modifiers = 

dotnet_naming_symbols.literal.applicable_kinds = field
dotnet_naming_symbols.literal.applicable_accessibilities = *
dotnet_naming_symbols.literal.required_modifiers = const

dotnet_naming_symbols.private_protected_cpo.applicable_kinds = field
