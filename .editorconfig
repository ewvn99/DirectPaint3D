dotnet_naming_symbols.private_protected_prop.applicable_accessibilities = private_protected
dotnet_naming_symbols.private_protected_prop.required_modifiers = 

dotnet_naming_symbols.private_prop.applicable_kinds = property
dotnet_naming_symbols.private_prop.applicable_accessibilities = private
dotnet_naming_symbols.private_prop.required_modifiers = 

dotnet_naming_symbols.internal_static_prop.applicable_kinds = property
dotnet_naming_symbols.internal_static_prop.applicable_accessibilities = internal
dotnet_naming_symbols.internal_static_prop.required_modifiers = static

dotnet_naming_symbols.internal_prop_o_evt.applicable_kinds = property, event
dotnet_naming_symbols.internal_prop_o_evt.applicable_accessibilities = internal
dotnet_naming_symbols.internal_prop_o_evt.required_modifiers = 

dotnet_naming_symbols.public_miembro.applicable_kinds = property, field, event, method
dotnet_naming_symbols.public_miembro.applicable_accessibilities = public
dotnet_naming_symbols.public_miembro.required_modifiers = 

dotnet_naming_symbols.local_static_met.applicable_kinds = local_function
dotnet_naming_symbols.local_static_met.applicable_accessibilities = *
dotnet_naming_symbols.local_static_met.required_modifiers = static

dotnet_naming_symbols.local_met.applicable_kinds = local_function
dotnet_naming_symbols.local_met.applicable_accessibilities = *
dotnet_naming_symbols.local_met.required_modifiers = 

# Estilos de nomenclatura

dotnet_naming_style.pascal_case.required_prefix = 
dotnet_naming_style.pascal_case.required_suffix = 
dotnet_naming_style.pascal_case.word_separator = 
dotnet_naming_style.pascal_case.capitalization = pascal_case

dotnet_naming_style.empieza_con_e.required_prefix = e
dotnet_naming_style.empieza_con_e.required_suffix = 
dotnet_naming_style.empieza_con_e.word_separator = 
dotnet_naming_style.empieza_con_e.capitalization = pascal_case

dotnet_naming_style.empieza_con_d.required_prefix = d
dotnet_naming_style.empieza_con_d.required_suffix = 
dotnet_naming_style.empieza_con_d.word_separator = 
dotnet_naming_style.empieza_con_d.capitalization = pascal_case

